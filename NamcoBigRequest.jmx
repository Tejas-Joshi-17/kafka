        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="prescript">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.util.Random
import java.util.Date
import java.text.SimpleDateFormat

// --- Random ID Generation (Equivalent to generateRandomId) ---
def generateRandomId = { digits -&gt;
    def random = new Random()
    def id = new StringBuilder()
    (1..digits).each {
        // nextInt(10) generates an integer between 0 (inclusive) and 9 (inclusive)
        id.append(random.nextInt(10))
    }
    return id.toString()
}

// --- Timestamp Generation (Equivalent to getCurrentTimestamp) ---
// The format pattern &apos;yyyyMMddHHmmss&apos; directly produces the desired string.
def getCurrentTimestamp = {
    def now = new Date()
    // &apos;format&apos; is a Groovy extension method on java.util.Date
    return now.format(&apos;yyyyMMddHHmmss&apos;)
}

// --- Execution and Storage ---
def CORRELATION_ID = generateRandomId(35)
def webTimeStamp = getCurrentTimestamp()

// Store the values in context variables (e.g., in ReadyAPI/SoapUI)
vars.put(&quot;CORRELATION_ID&quot;, CORRELATION_ID)
vars.put(&quot;web-timestmap&quot;, webTimeStamp)

// Optional: Log the values for verification
log.info(&quot;Generated CORRELATION_ID: &quot; + CORRELATION_ID)
log.info(&quot;Generated web-timestmap: &quot; + webTimeStamp)</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
